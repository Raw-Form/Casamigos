---
import { Image } from "astro:assets";

import LoungeImg from "../images/Lounge.webp";
import DiningroomImg from "../images/Diningroom.webp";
import HallImg from "../images/Hall.webp";
import KitchenImg from "../images/Kitchen.webp";
import BedroomImg from "../images/Bedroom.webp";
import BathroomImg from "../images/Bathroom.webp";
import FacadeImg from "../images/Facade.webp";
import BackyardImg from "../images/Backyard.webp";

const photos = [
  {
    id: "Lounge",
    label: "Lounge",
    image: LoungeImg,
    text: "Features a cozy lounge area centered around a fluted wood accent wall and soft white furniture, framed by expansive sliding glass doors that open up to the outdoors.",
  },
  {
    id: "Diningroom",
    label: "Dining room",
    image: DiningroomImg,
    text: "Provides a transition into the dining zone, highlighting a stunning marble-clad kitchen island paired with contemporary white barstools under soft, integrated ceiling lighting.",
  },
  {
    id: "Hall",
    label: "Hall",
    image: HallImg,
    text: "Captures the spacious hall perspective, seamlessly connecting the kitchen to a dramatic floating staircase with open wood treads and sleek glass railings.",
  },
  {
    id: "Kitchen",
    label: "Kitchen",
    image: KitchenImg,
    text: "Focuses deeply on the kitchen architecture, emphasizing the elegant marble backsplashes, light wood lower cabinetry, and a vertical wood-slat partition that brings structure and natural texture into the core of the home.",
  },
  {
    id: "Bedroom",
    label: "Bedroom",
    image: BedroomImg,
    text: "The bedroom defined by a vertical wood-slat feature wall behind a plush upholstered headboard. Large sliding doors invite natural light and tropical balcony views into the room, creating an airy, peaceful sanctuary.",
  },
  {
    id: "Bathroom",
    label: "Bathroom",
    image: BathroomImg,
    text: "The bathroom mirroring the home’s signature wood accents via a linear slatted wall panel and floating vanity. Earthy, textured stone wall finishes enclose a glass shower area centered around a frosted window that floods the space with diffused light.",
  },
  {
    id: "Facade",
    label: "Facade",
    image: FacadeImg,
    text: "The front facade highlighting geometric cubist forms balanced by a warm, vertical wood-paneled section. Large windows and a recessed entryway offer a glimpse of the illuminated interior, framed beautifully by palm trees and manicured lawns.",
  },
  {
    id: "Backyard",
    label: "Backyard",
    image: BackyardImg,
    text: "The backyard showcasing two levels of open-air living. Wide sliding glass doors seamlessly bridge the indoor spaces with a covered terrace, an upper balcony, and a lush green lawn ideal for outdoor relaxation.",
  },
];
---

<section id="Photos" class="h-full lg:h-[88dvh] w-full bg-primary p-4">
  <!-- display: mobile -->
  <div
    id="Photos_Mobile"
    class="h-full w-full grid grid-rows-10 gap-2 lg:hidden"
  >
    <div
      class="relative row-span-6 overflow-hidden rounded-[10px]"
    >
      {
        photos.map((ph, i) => (
          <div
            id={`PhotoWrap_m_${ph.id}`}
            class:list={[
              "property-image-m absolute inset-0",
              i !== 0 ? "opacity-0" : "opacity-100",
            ]}
          >
            {/* Fondo: misma imagen, recortada y desenfocada para rellenar el espacio */}
            <Image
              src={ph.image}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-60"
            />
            {/* Imagen principal: completa, sin recortar */}
            <Image
              src={ph.image}
              alt={ph.label}
              class="relative w-full h-full object-scale-down"
            />
          </div>
        ))
      }
    </div>
    <div class="relative row-span-3 grid px-2 bg-secondary/70 rounded-[10px]">
      {
        photos.map((ph, i) => (
          <p
            id={`Text_m_${ph.id}`}
            class:list={[
              "photo-text-m col-start-1 row-start-1 text-white text-center self-center",
              i !== 0 ? "opacity-0" : "opacity-100",
            ]}
          >
            {ph.text}
          </p>
        ))
      }
    </div>
    <div
      class="relative grid grid-cols-[repeat(8,1fr)] row-span-1 gap-4 px-2 py-1 bg-secondary rounded-[10px] overflow-x-scroll"
    >
      {
        photos.map((ph, i) => (
          <button
            type="button"
            id={`Btn_m_${ph.id}`}
            class="photo-btn-m text-primary"
            data-index={i}
          >
            <h6>{ph.label}</h6>
          </button>
        ))
      }
      <div
        id="Indicator_Mobile"
        class="absolute bottom-0 bg-primary h-2 opacity-0"
        style="left:0; width:0px;"
      >
      </div>
    </div>
  </div>

  <!-- display:desktop -->
  <div
    id="Photos_Desktop"
    class="hidden h-full w-full lg:grid lg:grid-cols-10 lg:grid-rows-10 lg:gap-4"
  >
    <div class="relative lg:col-span-8 xl:col-span-9 lg:row-span-8 xl:row-span-9 overflow-hidden rounded-[20px]">
      {
        photos.map((ph, i) => (
          <Image
            id={`Photo_d_${ph.id}`}
            src={ph.image}
            alt={ph.label}
            class:list={[
              "property-image-d absolute inset-0 object-cover w-full h-full",
              i !== 0 ? "opacity-0" : "opacity-100",
            ]}
          />
        ))
      }
    </div>
    <div
      class="px-2 py-1 relative lg:col-span-8 xl:col-span-9 lg:row-span-2 xl:row-span-1 grid rounded-[20px] bg-secondary/70"
    >
      {
        photos.map((ph, i) => (
          <p
            id={`Text_d_${ph.id}`}
            class:list={[
              "photo-text-d col-start-1 row-start-1 text-white text-center text-balance self-center",
              i !== 0 ? "opacity-0" : "opacity-100",
            ]}
          >
            {ph.text}
          </p>
        ))
      }
    </div>
    <div
      class="relative grid lg:col-span-2 xl:col-span-1 row-span-full bg-secondary rounded-[20px]"
    >
      {
        photos.map((ph, i) => (
          <button
            type="button"
            id={`Btn_d_${ph.id}`}
            class="photo-btn-d text-primary"
            data-index={i}
          >
            <h4>{ph.label}</h4>
          </button>
        ))
      }
      <div
        id="Indicator_Desktop"
        class="absolute left-0 w-1 bg-primary opacity-0"
        style="top:0; height:0px;"
      >
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  type Refs = {
    images: NodeListOf<HTMLElement>;
    texts: NodeListOf<HTMLElement>;
    buttons: NodeListOf<HTMLElement>;
    indicator: HTMLElement;
    axis: "x" | "y"; // x = horizontal (mobile), y = vertical (desktop)
  };

  function setupGallery(refs: Refs) {
    const { images, texts, buttons, indicator, axis } = refs;
    let currentIndex = 0;

    gsap.set(buttons, { opacity: 0.6, fontWeight: 400 });

    function moveIndicator(activeEl: HTMLElement) {
      if (axis === "x") {
        gsap.to(indicator, {
          left: activeEl.offsetLeft,
          width: activeEl.offsetWidth,
          opacity: 1,
          duration: 0.4,
          ease: "power3.inOut",
        });

        // Desplaza el carrusel de botones para que la opción activa quede visible
        activeEl.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      } else {
        gsap.to(indicator, {
          top: activeEl.offsetTop,
          height: activeEl.offsetHeight,
          opacity: 1,
          duration: 0.4,
          ease: "power3.inOut",
        });
      }
    }

    function activate(nextIndex: number, skipFade = false) {
      if (nextIndex === currentIndex && !skipFade) return;

      const prevIndex = currentIndex;
      const activeBtn = buttons[nextIndex];

      // Tag/label activo
      buttons.forEach((btn, i) => {
        gsap.to(btn, {
          opacity: i === nextIndex ? 1 : 0.6,
          fontWeight: i === nextIndex ? 700 : 400,
          duration: 0.3,
          ease: "power2.out",
        });
      });

      // Indicador se mueve hacia la opción elegida
      moveIndicator(activeBtn);

      if (!skipFade) {
        const tl = gsap.timeline();
        // Foto: fade out -> fade in
        tl.to(images[prevIndex], {
          opacity: 0,
          duration: 0.3,
          ease: "power1.in",
        })
          .to(
            images[nextIndex],
            { opacity: 1, duration: 0.4, ease: "power2.out" },
            ">",
          )
          // Texto: fade out -> fade in (en paralelo con la foto)
          .to(
            texts[prevIndex],
            { opacity: 0, duration: 0.3, ease: "power1.in" },
            0,
          )
          .to(
            texts[nextIndex],
            { opacity: 1, duration: 0.4, ease: "power2.out" },
            0.3,
          );
      }

      currentIndex = nextIndex;
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener("click", () => activate(i));
    });

    // Estado inicial: solo posiciona el indicador, sin animar fotos/textos
    requestAnimationFrame(() => activate(0, true));

    // Reajustar el indicador si cambia el tamaño (p.ej. rotación del móvil)
    window.addEventListener("resize", () => {
      moveIndicator(buttons[currentIndex]);
    });
  }

  // Mobile
  setupGallery({
    images: document.querySelectorAll<HTMLElement>(
      "#Photos_Mobile .property-image-m",
    ),
    texts: document.querySelectorAll<HTMLElement>(
      "#Photos_Mobile .photo-text-m",
    ),
    buttons: document.querySelectorAll<HTMLElement>(
      "#Photos_Mobile .photo-btn-m",
    ),
    indicator: document.getElementById("Indicator_Mobile") as HTMLElement,
    axis: "x",
  });

  // Desktop
  setupGallery({
    images: document.querySelectorAll<HTMLElement>(
      "#Photos_Desktop .property-image-d",
    ),
    texts: document.querySelectorAll<HTMLElement>(
      "#Photos_Desktop .photo-text-d",
    ),
    buttons: document.querySelectorAll<HTMLElement>(
      "#Photos_Desktop .photo-btn-d",
    ),
    indicator: document.getElementById("Indicator_Desktop") as HTMLElement,
    axis: "y",
  });
</script>
