---
import { Image } from "astro:assets";

import LoungeImg from "../images/Lounge.webp";
import DiningroomImg from "../images/Diningroom.webp";
import HallImg from "../images/Hall.webp";
import KitchenImg from "../images/Kitchen.webp";
import BedroomImg from "../images/Bedroom.webp";
import BathroomImg from "../images/Bathroom.webp";
import FacadeImg from "../images/Facade.webp";
import BackyardImg from "../images/Backyard.webp";

const photos = [
  {
    id: "Lounge",
    label: "Lounge",
    image: LoungeImg,
    text: "Features a cozy lounge area centered around a fluted wood accent wall and soft white furniture, framed by expansive sliding glass doors that open up to the outdoors.",
  },
  {
    id: "Diningroom",
    label: "Dining room",
    image: DiningroomImg,
    text: "Provides a transition into the dining zone, highlighting a stunning marble-clad kitchen island paired with contemporary white barstools under soft, integrated ceiling lighting.",
  },
  {
    id: "Hall",
    label: "Hall",
    image: HallImg,
    text: "Captures the spacious hall perspective, seamlessly connecting the kitchen to a dramatic floating staircase with open wood treads and sleek glass railings.",
  },
  {
    id: "Kitchen",
    label: "Kitchen",
    image: KitchenImg,
    text: "Focuses deeply on the kitchen architecture, emphasizing the elegant marble backsplashes, light wood lower cabinetry, and a vertical wood-slat partition that brings structure and natural texture into the core of the home.",
  },
  {
    id: "Bedroom",
    label: "Bedroom",
    image: BedroomImg,
    text: "The bedroom defined by a vertical wood-slat feature wall behind a plush upholstered headboard. Large sliding doors invite natural light and tropical balcony views into the room, creating an airy, peaceful sanctuary.",
  },
  {
    id: "Bathroom",
    label: "Bathroom",
    image: BathroomImg,
    text: "The bathroom mirroring the home’s signature wood accents via a linear slatted wall panel and floating vanity. Earthy, textured stone wall finishes enclose a glass shower area centered around a frosted window that floods the space with diffused light.",
  },
  {
    id: "Facade",
    label: "Facade",
    image: FacadeImg,
    text: "The front facade highlighting geometric cubist forms balanced by a warm, vertical wood-paneled section. Large windows and a recessed entryway offer a glimpse of the illuminated interior, framed beautifully by palm trees and manicured lawns.",
  },
  {
    id: "Backyard",
    label: "Backyard",
    image: BackyardImg,
    text: "The backyard showcasing two levels of open-air living. Wide sliding glass doors seamlessly bridge the indoor spaces with a covered terrace, an upper balcony, and a lush green lawn ideal for outdoor relaxation.",
  },
];
---

<section id="Photos" class="h-[88dvh] w-full p-4 md:p-10 bg-primary">
  <div
    class="relative w-full h-full rounded-[30px] flex flex-col lg:flex-row gap-3 lg:gap-5"
  >
    <!-- ① IMAGEN: arriba en móvil, derecha en desktop -->
    <div
      class="relative w-full flex-1 min-h-0 overflow-hidden rounded-[20px] lg:rounded-[30px] order-1 lg:order-2"
    >
      {
        photos.map((photo, i) => (
          <>
            <Image
              id={`Photo_${photo.id}`}
              src={photo.image}
              alt={photo.label}
              class:list={[
                "property-image absolute inset-0 object-cover w-full h-full",
                i !== 0 ? "opacity-0" : "opacity-100",
              ]}
            />
            <div
              id={`Text_${photo.id}`}
              class:list={[
                "photo-text absolute inset-x-0 bottom-0 z-20 px-4 pb-4",
                i !== 0 ? "opacity-0" : "opacity-100",
              ]}
            >
              <div class="px-1 py-2 lg:px-2 lg:py-4 bg-primary/20 backdrop-blur-xs rounded-2xl">
                <p class="text-center text-white">{photo.text}</p>
              </div>
            </div>
          </>
        ))
      }
    </div>

    <!-- ② TÍTULOS: scroll horizontal en móvil, columna vertical en desktop -->
    <div
      class="relative shrink-0 order-2 lg:order-1
        bg-secondary rounded-[20px] lg:rounded-[30px]
        flex flex-row items-center gap-1
        overflow-x-auto overflow-y-hidden
        px-4 py-3
        lg:flex-col lg:items-start lg:justify-around
        lg:overflow-x-visible lg:overflow-y-visible
        lg:px-5 lg:py-10
        no-scrollbar"
    >
      <!-- Indicador lateral: solo visible en desktop -->
      <div
        id="Photos_Indicator"
        class="hidden lg:block absolute left-0 w-[3px] bg-primary rounded-full pointer-events-none opacity-0"
        style="top:0; height:0px;"
      >
      </div>

      <!-- Indicador inferior: solo visible en móvil/tablet -->
      <div
        id="Photos_Indicator_Mobile"
        class="lg:hidden absolute bottom-0 h-[3px] bg-primary rounded-full pointer-events-none opacity-0"
        style="left:0; width:0px;"
      >
      </div>

      {
        photos.map((photo) => (
          <h2
            id={`Title_${photo.id}`}
            class="
            photos-title cursor-pointer select-none
            text-primary/70 whitespace-nowrap
            text-sm md:text-base
            px-2 py-1
            lg:text-2xl lg:whitespace-normal lg:px-0 lg:py-0
          "
          >
            {photo.label}
          </h2>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Ocultar scrollbar manteniendo la funcionalidad */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
<script>
  import gsap from "gsap";

  const titles = document.querySelectorAll<HTMLElement>(
    "#Photos .photos-title",
  );
  const images = document.querySelectorAll<HTMLElement>(".property-image");
  const texts = document.querySelectorAll<HTMLElement>(".photo-text");
  const indicatorDesk = document.getElementById(
    "Photos_Indicator",
  ) as HTMLElement;
  const indicatorMobile = document.getElementById(
    "Photos_Indicator_Mobile",
  ) as HTMLElement;

  let currentIndex = 0;

  const isDesktop = () => window.innerWidth >= 1024;

  gsap.set(titles, { opacity: 0.2, fontWeight: 400 });

  function activateTitle(nextIndex: number, skipImageFade = false) {
    const prevIndex = currentIndex;
    const activeEl = titles[nextIndex];
    const tl = gsap.timeline();

    titles.forEach((title, i) => {
      const isActive = i === nextIndex;
      tl.to(
        title,
        {
          opacity: isActive ? 1 : 0.9,
          fontWeight: isActive ? 700 : 400,
          x: isDesktop() ? (isActive ? 10 : 0) : 0,
          scale: isDesktop() ? 1 : isActive ? 1.05 : 1,
          duration: 0.4,
          ease: "power2.out",
        },
        0,
      );
    });

    if (isDesktop()) {
      const rect = activeEl.getBoundingClientRect();
      const parentRect = indicatorDesk.parentElement!.getBoundingClientRect();
      tl.to(
        indicatorDesk,
        {
          top: rect.top - parentRect.top,
          height: rect.height,
          opacity: 1,
          duration: 0.45,
          ease: "power3.inOut",
        },
        0,
      );
    }

    if (!isDesktop()) {
      tl.to(
        indicatorMobile,
        {
          left: activeEl.offsetLeft,
          width: activeEl.offsetWidth,
          opacity: 1,
          duration: 0.4,
          ease: "power3.inOut",
        },
        0,
      );

      activeEl.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center",
      });
    }

    if (!skipImageFade) {
      tl.to(
        images[prevIndex],
        { opacity: 0, scale: 1.03, duration: 0.3, ease: "power1.in" },
        0,
      )
        .to(
          images[nextIndex],
          { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" },
          0.3,
        )
        .to(
          texts[prevIndex],
          { opacity: 0, duration: 0.3, ease: "power1.in" },
          0,
        ) // sale con la imagen
        .to(
          texts[nextIndex],
          { opacity: 1, duration: 0.4, ease: "power2.out" },
          0.3,
        ); // entra con la imagen
    }

    currentIndex = nextIndex;
  }

  titles.forEach((title, i) => {
    title.addEventListener("click", () => activateTitle(i));
  });

  activateTitle(0, true);
</script>
