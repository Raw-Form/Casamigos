---

<section id="Photos" class="h-[88dvh] w-full p-4 md:p-10 bg-primary">
  <div
    class="relative w-full h-full rounded-[30px] flex flex-col lg:flex-row gap-3 lg:gap-5"
  >
    <!-- ① IMAGEN: arriba en móvil, derecha en desktop -->
    <div
      class="relative w-full flex-1 min-h-0 overflow-hidden rounded-[20px] lg:rounded-[30px] order-1 lg:order-2"
    >
      {
        photos.map((photo, i) => (
          <div class="w-full h-full flex items-end pb-4 px-4 ">
            <Image
              id={`Photo_${photo.id}`}
              src={photo.image}
              alt={photo.label}
              class:list={[
                "property-image absolute inset-0 object-cover w-full h-full",
                i !== 0 ? "opacity-0" : "opacity-100",
              ]}
            />
            <div class="z-20  px-1 py-2 lg:px-2 lg:py-4 bg-primary/20 backdrop-blur-xs rounded-2xl">
              <p class="text-center text-white">
                {photo.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- ② TÍTULOS: scroll horizontal en móvil, columna vertical en desktop -->
    <div
      class="relative shrink-0 order-2 lg:order-1
        bg-secondary rounded-[20px] lg:rounded-[30px]
        flex flex-row items-center gap-1
        overflow-x-auto overflow-y-hidden
        px-4 py-3
        lg:flex-col lg:items-start lg:justify-around
        lg:overflow-x-visible lg:overflow-y-visible
        lg:px-5 lg:py-10
        no-scrollbar"
    >
      <!-- Indicador lateral: solo visible en desktop -->
      <div
        id="Photos_Indicator"
        class="hidden lg:block absolute left-0 w-[3px] bg-primary rounded-full pointer-events-none opacity-0"
        style="top:0; height:0px;"
      >
      </div>

      <!-- Indicador inferior: solo visible en móvil/tablet -->
      <div
        id="Photos_Indicator_Mobile"
        class="lg:hidden absolute bottom-0 h-[3px] bg-primary rounded-full pointer-events-none opacity-0"
        style="left:0; width:0px;"
      >
      </div>

      {
        photos.map((photo) => (
          <h2
            id={`Title_${photo.id}`}
            class="
            photos-title cursor-pointer select-none
            text-primary/70 whitespace-nowrap
            text-sm md:text-base
            px-2 py-1
            lg:text-2xl lg:whitespace-normal lg:px-0 lg:py-0
          "
          >
            {photo.label}
          </h2>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Ocultar scrollbar manteniendo la funcionalidad */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
<script>
  import gsap from "gsap";

  const titles = document.querySelectorAll<HTMLElement>(
    "#Photos .photos-title",
  );
  const images = document.querySelectorAll<HTMLElement>(".property-image");
  const indicatorDesk = document.getElementById(
    "Photos_Indicator",
  ) as HTMLElement;
  const indicatorMobile = document.getElementById(
    "Photos_Indicator_Mobile",
  ) as HTMLElement;

  let currentIndex = 0;

  const isDesktop = () => window.innerWidth >= 1024;

  gsap.set(titles, { opacity: 0.2, fontWeight: 400 });

  function activateTitle(nextIndex: number, skipImageFade = false) {
    const prevIndex = currentIndex;
    const activeEl = titles[nextIndex];
    const tl = gsap.timeline();

    titles.forEach((title, i) => {
      const isActive = i === nextIndex;
      tl.to(
        title,
        {
          opacity: isActive ? 1 : 0.9,
          fontWeight: isActive ? 700 : 400,
          x: isDesktop() ? (isActive ? 10 : 0) : 0,
          scale: isDesktop() ? 1 : isActive ? 1.05 : 1,
          duration: 0.4,
          ease: "power2.out",
        },
        0,
      );
    });

    if (isDesktop()) {
      const rect = activeEl.getBoundingClientRect();
      const parentRect = indicatorDesk.parentElement!.getBoundingClientRect();
      tl.to(
        indicatorDesk,
        {
          top: rect.top - parentRect.top,
          height: rect.height,
          opacity: 1,
          duration: 0.45,
          ease: "power3.inOut",
        },
        0,
      );
    }

    if (!isDesktop()) {
      tl.to(
        indicatorMobile,
        {
          left: activeEl.offsetLeft,
          width: activeEl.offsetWidth,
          opacity: 1,
          duration: 0.4,
          ease: "power3.inOut",
        },
        0,
      );

      activeEl.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center",
      });
    }

    if (!skipImageFade) {
      tl.to(
        images[prevIndex],
        { opacity: 0, scale: 1.03, duration: 0.3, ease: "power1.in" },
        0,
      ).to(
        images[nextIndex],
        { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" },
        0.3,
      );
    }

    currentIndex = nextIndex;
  }

  titles.forEach((title, i) => {
    title.addEventListener("click", () => activateTitle(i));
  });

  activateTitle(0, true);
</script>
