---
import { Image } from "astro:assets";
import Turk_1 from "../images/Turk_1.webp";
import Turk_2 from "../images/Turk_2.webp";
import Turk_3 from "../images/Turk_3.webp";
import Turk_4 from "../images/Turk_4.webp";
import Turk_5 from "../images/Turk_5.webp";
---

<section
  class="grid grid-rows-2 lg:grid-cols-2 w-full gap-3 h-[75dvh] p-10 border-accent border-2"
>
  <div class="overflow-hidden rounded-sm">
    <Image src={Turk_1} alt="Turk and Caicos image 1" class="w-full h-full object-cover"/>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div class="overflow-hidden rounded-sm">
      <Image src={Turk_2} alt="Turk and Caicos image 2" class="w-full h-full object-cover"/>
    </div>
    <div class="overflow-hidden rounded-sm">
      <Image src={Turk_3} alt="Turk and Caicos image 3" class="w-full h-full object-cover"/>
    </div>
    <div class="overflow-hidden rounded-sm">
      <Image src={Turk_4} alt="Turk and Caicos image 4" class="w-full h-full object-cover"/>
    </div>
    <div class="overflow-hidden rounded-sm">
      <Image src={Turk_5} alt="Turk and Caicos image 5" class="w-full h-full object-cover"/>
    </div>
  </div>
</section>

