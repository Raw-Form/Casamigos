---
import { Image } from "astro:assets";
import Turk_6 from "../images/Turk_6.webp";
import Turk_7 from "../images/Turk_7.webp";
import Turk_8 from "../images/Turk_8.webp";
import Turk_9 from "../images/Turk_9.webp";
import Turk_10 from "../images/Turk_10.webp";
---

<section class="grid grid-cols-6 grid-rows-4 gap-5 h-[75vh] p-10 bg-secondary">
  <div class="col-span-4 row-span-2 overflow-hidden rounded-sm">
    <Image src={Turk_6} alt="" class="w-full h-full object-cover" />
  </div>

  <div class="col-span-2 row-span-2 overflow-hidden rounded-sm">
    <Image src={Turk_7} alt="" class="w-full h-full object-cover" />
  </div>

  <div class="col-span-2 row-span-1 overflow-hidden rounded-sm">
    <Image src={Turk_8} alt="" class="w-full h-full object-cover" />
  </div>

  <div class="col-span-4 row-span-1 overflow-hidden rounded-sm">
    <Image src={Turk_9} alt="" class="w-full h-full object-cover" />
  </div>

  <div class="col-span-6 row-span-1 overflow-hidden rounded-sm">
    <Image src={Turk_10} alt="" class="w-full h-full object-cover" />
  </div>
</section>
