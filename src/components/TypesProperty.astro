---
import Print_1 from "../images/Prints_1.svg";
import Print_2 from "../images/Prints_2.svg";
import Bedrooms from "../images/Bedrooms.svg";
import Bathrooms from "../images/Bathrooms.svg";
import Pool from "../images/Pool.svg";

const Prints = [
  {
    src: Print_1.src,
    alt: "property type 1",
  },
  {
    src: Print_2.src,
    alt: "property type 1",
  },
];
---

<section
  id="TypesProperty"
  class="min-h-screen lg:h-[75vh] w-full flex flex-col items-center p-10 bg-primary text-white"
>
  <h2 class="text-secondary">Property</h2>
  <ul class="flex justify-start w-full gap-2 p-1">
    {
      Prints.map((i, index) => (
        <li class=" w-20  transition-all duration-300 ease-in-out ">
          <button
            id={`Prints_${index + 1}`}
            class="bg-secondary rounded-lg hover:bg-accent active:brightness-125 focus-within:ring-4 focus-within:ring-accent text-primary px-2 w-full"
          >
            Tipo {index + 1}
          </button>
        </li>
      ))
    }
  </ul>
  <div class="flex flex-col grow w-full min-h-0">
    <div
      class="w-full h-full relative bg-primary"
    >
      <picture>
        <img
          id="PrintImg"
          src={Prints[0].src}
          alt={Prints[0].alt}
          class="object-contain w-full h-full"
        />
      </picture>
    </div>
  </div>
  <div class="w-full flex flex-col sm:flex-row items-center">
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi ipsum
      libero, efficitur vel leo et, commodo ultrices enim. Donec lectus velit,
      venenatis ut iaculis ut, facilisis semper est. Maecenas scelerisque sem
      nec condimentum congue. Donec ac purus eleifend, fringilla eros sit amet,
      vestibulum dolor.
    </p>
    <div class=" text-center w-full lg:w-1/2 h-full">
      <h3><span class="text-bold text-secondary">Total area:</span> 0.33 acres   </h3>
      <div class="flex gap-5 justify-center">
        <div class="flex items-center gap-2"><Bedrooms class="h-6 aspect-square text-secondary"/><p class="text-2xl font-semibold">3</p></div>
        <div class="flex items-center gap-2"><Bathrooms class="h-6 aspect-square text-secondary"/><p class="text-2xl font-semibold">3.5</p></div>
        <div class="flex items-center gap-2"><Pool class="h-6 aspect-square text-secondary"/><p class="text-2xl font-semibold">1</p></div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ Prints }}>
  const img = document.getElementById("PrintImg");
  const buttons = document.querySelectorAll("button[id^='Prints_']");

  buttons.forEach((btn, index) => {
    btn.addEventListener("click", () => {
      img.src = Prints[index].src;
      img.alt = Prints[index].alt;

      buttons.forEach((b) => b.classList.remove("bg-accent"));
      btn.classList.add("bg-accent");
    });
  });
</script>
