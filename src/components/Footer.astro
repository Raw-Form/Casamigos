---
import InstagramLogo from "../images/InstagramLogo.svg";
import FacebookLogo from "../images/Facebook.svg";
import MailLogo from "../images/email.svg";
import WhatsappLogo from "../images/whatsappLogo.svg";
import RawFormLogo from "../images/LogoRawForm.svg";
import CasamigosLogo from "../images/Logo.svg";
---

<footer
  id="ContactUs"
  class="z-60 h-fit w-full pt-10 px-10 bg-primary text-white flex flex-col items-center gap-10"
>
  <div class="flex flex-col lg:flex-row justify-evenly w-full divide-x-0 divide-y-2 lg:divide-y-0 lg:divide-x-2 ">
    <div class="flex flex-col w-full gap-2 items-center justify-center ">
      <div class="flex items-center gap-2 ">
        <CasamigosLogo class="h-[2.074rem]" />
        <h3>Casamigos</h3>
      </div>
      <div class="flex gap-1">
        <a href="https://www.instagram.com/casamigostci?igsh=MXB2eDE2OGRuODE0YQ=="><InstagramLogo class="h-5" /></a>
        <a href="https://wa.link/ji1spj"><WhatsappLogo class="h-5" /></a>
      </div>
    </div>
    <div class="w-full text-center ">
      <h6>Menu</h6>
      <ul>
        <li>Home</li>
        <li>About Us</li>
        <li>Localization</li>
        <li>Properties</li>
        <li>Photos</li>
      </ul>
    </div>
    <div class="w-full text-center ">
      <h6>Info</h6>
    </div>
  </div>
  <div class="flex gap-2 text-secondary">
    <h6>Developed By Rawform</h6><RawFormLogo class="h-5" />
  </div>
</footer>
