---
import "../styles/global.css";

import Layout from "../layout/layout.astro";
import Hero from "../components/Hero.astro";
import AboutUs from "../components/AboutUs.astro";
import FirstPhotos from "../components/FirstPhotos.astro";
import Localization from "../components/Localization.astro";
import SecondPhotos from "../components/SecondPhotos.astro";
import TypesProperty from "../components/TypesProperty.astro";
import Photos from "../components/Photos.astro";
import ContactButton from "../components/ContactButton.astro";
---

<Layout>
  <div id="Hero">
    <div id="mask-overlay">
      <div id="mask-content">
        <Hero />
      </div>
    </div>
  </div>
  <AboutUs />
  <FirstPhotos />
  <Localization />
  <SecondPhotos />
  <TypesProperty />
  <Photos />
  <ContactButton />
</Layout>

<style>
  .section {
    height: 100dvh;
  }

  #mask-overlay {
    overflow: hidden;
    mask-image: url("../images/Logo.svg");
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 50dvh;
  }

  #logo-overlay {
    overflow: hidden;
    mask-image: url("../images/Logo.svg");
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    ease: "power1.inOut",
    scrollTrigger: {
      scrub: 1,
      trigger: "#Hero",
      start: "top top",
      end: "+=500",
      pin: true,
    },
  });

  tl.to("#mask-overlay", {
    maskSize: "8000vh",
    maskPosition: "center 90% ",
  })
    .to(
      "#header",
      {
        opacity: 1,
        duration: 1,
      },
      "<0.4",
    )
    .to(
      "#Title",
      {
        opacity: 1,
      },
      "<",
    )
    .to(
      "#ContactButton",
      {
        opacity: 1,
        pointerEvents: "auto",
      },
      "<",
    );

  const tlRender = gsap.timeline({
    scrollTrigger: {
      trigger: "#Render",
      start: "top 12%",
      end: "+=1000", // controla cuánto dura el efecto
      scrub: true,
      pin: true,
    },
  });

  tlRender.to("#Render", {
    backgroundColor: "#85c79a", // tu primary
    ease: "none",
  });

  // ─── Estado central ───────────────────────────────────────────────
  let state = 0;

 
</script>
